# =============================================================================
# بيت القفطان — Environment variables
# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard → Project Settings → API.
# =============================================================================

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Safe to expose to the browser. Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — bypasses Row Level Security completely.
# Never prefix it with NEXT_PUBLIC_, never import it into a Client Component,
# and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# The zone every date and time is displayed in. Inlined at build time so the
# server and the browser agree — a per-request value would reintroduce the
# hydration mismatch this exists to prevent. Should match the timezone recorded
# in store settings; the system screen flags it when they diverge.
NEXT_PUBLIC_STORE_TIMEZONE=Asia/Amman
